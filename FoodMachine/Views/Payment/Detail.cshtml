@model Food.Dal.Models.Admin.ProductViewModel


@{
    int fullStars = (int)Math.Floor(Model.AverageRating);
    int halfStar = (Model.AverageRating - fullStars) >= 0.5 ? 1 : 0;
    int emptyStars = 5 - fullStars - halfStar;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>@Model.Name - EShopper</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="img/favicon.ico" rel="icon">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="css/style.css" rel="stylesheet">
</head>
<body>

    <!-- Page Header -->
    <div class="container-fluid bg-secondary mb-5">
        <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 300px">
            <h1 class="font-weight-semi-bold text-uppercase mb-3">Food Detail</h1>
            <div class="d-inline-flex">
                <p class="m-0"><a href="/">Home</a></p>
                <p class="m-0 px-2">-</p>
                <p class="m-0">@Model.Name</p>
            </div>
        </div>
    </div>

    <!-- Shop Detail -->
    <div class="container-fluid py-5">
        <div class="row px-xl-5">
            <!-- Product Image -->
            <div class="col-lg-5 pb-5">
                <div class="border">
                    <img class="w-100 h-100" src="~/img/products/@Model.MainImage" alt="@Model.Name">
                </div>
            </div>

            <!-- Product Info -->
            <div class="col-lg-7 pb-5">
                <h3 class="font-weight-semi-bold">@Model.Name</h3>

                <!-- Average Rating -->
                <div class="d-flex mb-3">
                    <div class="text-primary mr-2">
                        @for (int i = 0; i < fullStars; i++)
                        {
                            <i class="fas fa-star"></i>
                        }
                        @for (int i = 0; i < halfStar; i++)
                        {
                            <i class="fas fa-star-half-alt"></i>
                        }
                        @for (int i = 0; i < emptyStars; i++)
                        {
                            <i class="far fa-star"></i>
                        }
                    </div>
                    <small class="pt-1">(@Model.RatingCount Reviews)</small>
                </div>

                <small class="pt-1">(@Model.RatingCount Reviews)</small>
                <div class="mt-1">
                    <h3 class="font-weight-semi-bold mb-2 ">$@Model.Price</h3>
                    <h4 class="font-weight-semi-bold mb-2 ">Description:</h4>
                    <p class="mb-4 mt-1">@Model.Description</p>
                </div>
                <div class="d-flex mb-3 ">
                    <p class="text-dark font-weight-medium mb-0 mr-3">Sizes:</p>
                    <form>
                        @foreach (var size in new[] { "XS", "S", "M", "L", "XL" })
                        {
                            var id = "size-" + size;
                            <div class="custom-control custom-radio custom-control-inline">
                                <input type="radio" class="custom-control-input" id="@id" name="size">
                                <label class="custom-control-label" for="@id">@size</label>
                            </div>
                        }
                    </form>
                </div>
                <div class="d-flex mb-2">
                    <p class="text-dark font-weight-medium mb-0 mr-3">Colors:</p>
                    <form>
                        @foreach (var color in new[] { "Black", "White", "Red", "Blue", "Green" })
                        {
                            var id = "color-" + color;
                            <div class="custom-control custom-radio custom-control-inline">
                                <input type="radio" class="custom-control-input" id="@id" name="color">
                                <label class="custom-control-label" for="@id">@color</label>
                            </div>
                        }
                    </form>

                </div>
                <div class="d-flex align-items-center mb-4 pt-2">
                    <div class="input-group quantity mr-3" style="width: 130px;">
                        <div class="input-group-btn">
                            <button class="btn btn-primary btn-minus"><i class="fa fa-minus"></i></button>
                        </div>
                        <input type="text" class="form-control bg-secondary text-center" value="1">
                        <div class="input-group-btn">
                            <button class="btn btn-primary btn-plus"><i class="fa fa-plus"></i></button>
                        </div>
                    </div>
                    <button class="btn btn-primary px-3 text-dark" onclick="addToCart(@Model.Id)">
                        <i class="fa fa-shopping-cart mr-1"></i> Add To Cart
                    </button>
                </div>
                <div class="d-flex pt-2">
                    <p class="text-dark font-weight-medium mb-0 mr-2">Share on:</p>
                    <div class="d-inline-flex">
                        @foreach (var social in new[] { "facebook-f", "twitter", "linkedin-in", "pinterest" })
                        {
                            <a class="text-dark px-2" href="#"><i class="fab fa-@social"></i></a>
                        }
                    </div>
                </div>

            </div>

         
           
        </div>
    </div>

    <!-- Tabs: Description / Information / Reviews -->
    <div class="row px-xl-5">
        <div class="col">
            <div class="nav nav-tabs justify-content-center border-secondary mb-4">
                <a class="nav-item nav-link active" data-toggle="tab" href="#tab-description">Description</a>
                <a class="nav-item nav-link" data-toggle="tab" href="#tab-information">Information</a>
                <a class="nav-item nav-link" data-toggle="tab" href="#tab-reviews">Reviews (@Model.RatingCount)</a>
            </div>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="tab-description">
                    <h4 class="mb-3">Product Description</h4>
                    <p>@Model.Description</p>
                </div>

                <div class="tab-pane fade" id="tab-information">
                    <h4 class="mb-3">Additional Information</h4>
                    <p>Here you can add more product details if needed.</p>
                </div>

                <div class="tab-pane fade" id="tab-reviews">
                    <div class="row">
                        <div class="col-md-6">
                            <h4 class="mb-4">Leave a Review</h4>
                            <small>Your email address will not be published. Required fields are marked *</small>

                            <!-- Star Rating -->
                            <div class="d-flex my-3">
                                <p class="mb-0 mr-2">Your Rating * :</p>
                                <div class="text-primary" id="starRating">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="far fa-star" data-value="@i"></i>
                                    }
                                </div>
                            </div>

                            <!-- Review Form -->
                            <form id="reviewForm" onsubmit="submitReview(event, @Model.Id)">
                                <div class="form-group">
                                    <label for="message">Your Review *</label>
                                    <textarea id="message" class="form-control" rows="5"></textarea>
                                </div>
                                <div class="form-group">
                                    <label for="name">Your Name *</label>
                                    <input type="text" id="name" class="form-control">
                                </div>
                                <div class="form-group mb-0">
                                    <input type="submit" value="Submit Review" class="btn btn-primary px-3">
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <div class="container-fluid py-5">
        <div class="text-center mb-4">
            <h2 class="section-title px-5"><span class="px-2">You May Also Like</span></h2>
        </div>
        <div class="row px-xl-5">
            <div class="col">
                <div class="owl-carousel related-carousel">
                    @foreach (var item in Model.ListProducts)
                    {
                        <div class="card product-item border-0">
                            <div class="card-header product-img overflow-hidden bg-transparent border p-0">
                                <img class="img-fluid w-100" src="~/img/products/@item.MainImage" alt="@item.Name">
                            </div>
                            <div class="card-body text-center p-0 pt-4 pb-3">
                                <h6 class="text-truncate mb-3">@item.Name</h6>
                                <div class="d-flex justify-content-center">
                                    <h6>$@item.Price</h6>
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-between bg-light border">
                                <a href="/payment/detail/@item.Id" class="btn btn-sm text-dark p-0">
                                    <i class="fas fa-eye text-primary mr-1"></i>View Detail
                                </a>
                                <a href="javascript:void(0)" onclick="addToCart(@item.Id)" class="btn btn-sm text-dark p-0">
                                    <i class="fas fa-shopping-cart text-primary mr-1"></i>Add To Cart
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    </div>

    <a href="#" class="btn btn-primary back-to-top"><i class="fa fa-angle-double-up"></i></a>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src="lib/owlcarousel/owl.carousel.min.js"></script>
    <script>
        let selectedRating = 0;
        const stars = document.querySelectorAll('#starRating i');

        stars.forEach((star, idx) => {
            star.addEventListener('mouseover', () => {
                stars.forEach((s, i) => s.classList.toggle('fas', i <= idx));
                stars.forEach((s, i) => s.classList.toggle('far', i > idx));
            });

            star.addEventListener('mouseout', () => {
                stars.forEach((s, i) => s.classList.toggle('fas', i < selectedRating));
                stars.forEach((s, i) => s.classList.toggle('far', i >= selectedRating));
            });

            star.addEventListener('click', () => {
                selectedRating = idx + 1;
                stars.forEach((s, i) => s.classList.toggle('fas', i < selectedRating));
                stars.forEach((s, i) => s.classList.toggle('far', i >= selectedRating));
            });
        });

        function submitReview(e, productId) {
            e.preventDefault();
            const name = document.getElementById('name').value;
            const message = document.getElementById('message').value;

            if(!selectedRating || !name){
                alert('Please provide a rating and your name!');
                return;
            }

            fetch('/payment/detail/addRating', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    ProductId: productId,
                    Rating: selectedRating,
                    Name: name,
                    Message: message
                })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success){
                    alert('Rating submitted!');
                    location.reload();
                } else {
                    alert('Error submitting rating.');
                }
            });
        }
    </script>

</body>
</html>
